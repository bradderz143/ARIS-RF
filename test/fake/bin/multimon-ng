#!/usr/bin/env python3
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import logargs, REAL
logargs("multimon-ng")
a = sys.argv[1:]
if any("aris_selftest" in x for x in a) and not os.environ.get("FAKE_BROKEN_MM"):
    os.execv(os.path.join(REAL, "multimon-ng"), [os.path.join(REAL, "multimon-ng")] + a)
if "-h" in a:
    sys.stderr.write("multimon-ng 1.2.0\n   Available demodulators: POCSAG512 POCSAG1200 POCSAG2400 FLEX FLEX_NEXT EAS UFSK1200 CLIPFSK\n"
                     "   FMSFSK AFSK1200 AFSK2400 DTMF ZVEI1 MORSE_CW\n")
    sys.exit(1)
d = [a[i + 1] for i, x in enumerate(a) if x == "-a"]
if "UFSK1200" in d:
    print("UFSK1200: [0x98]")
if "POCSAG1200" in d and os.environ.get("FAKE_MM_VALID"):
    print("POCSAG1200: Address:  123456  Function: 0  Alpha:   UNIT 7 RESPOND TO STATION")
